# Path to the Caddyfile on the host system
CADDYFILE_PATH=/etc/caddy/Caddyfile

# Port the app listens on (default: 3000)
# Next.js reads this natively — no extra configuration needed.
# PORT=3000

# Address to bind to (default: all interfaces, IPv4 + IPv6)
# HOST=::

# Restrict access to local/LAN IPs only (default: true)
# Set to false to allow connections from any IP
# LOCAL_ONLY=false

# Reverse proxies allowed to report the client IP via X-Forwarded-For,
# comma-separated. Leave unset when browsers connect to this app directly.
# TRUSTED_PROXIES=127.0.0.1,::1

# Shared-secret token for authentication (required).
# Without it every request gets a 503, unless DISABLE_AUTH=true.
# Generate with: openssl rand -hex 32
SECRET_TOKEN=
# DISABLE_AUTH=true

# Binary paths (optional overrides for non-standard distros or macOS)
# Defaults shown — only set these if your system uses different paths.
# TEE_BIN=/usr/bin/tee
# CADDY_BIN=/usr/bin/caddy
# SYSTEMCTL_BIN=/bin/systemctl
# JOURNALCTL_BIN=/usr/bin/journalctl

# User Caddy runs as; `caddy validate` runs as this user via sudo -u
# CADDY_USER=caddy
